---
import {FaEnvelope, FaGithub, FaLinkedinIn} from "react-icons/fa";
import PageHTML from "../../layouts/PageHTML.astro";
import {trans} from "../../i18n/index"
import { AVAILABLE_LANGS } from "../../consts";

const {locale} = Astro.params;

// Validate locale
if (!AVAILABLE_LANGS.includes(locale as any)) {
  return Astro.redirect("/404")
}

const t = trans[locale as ValidLocale].about;

---

<PageHTML
  title={t.page_title}
  description={t.page_description}
  lang={locale}
  type="website"
  date="2021-05-28"
>
  <section
    class="mx-auto mt-20 flex h-[90vh] max-w-[70ch] flex-col items-center justify-evenly px-10 leading-loose"
  >
    <h1 class="text-3xl text-primario">
      {t.who_is} <strong>Lasfito</strong> ?
    </h1>

    <h2 class="my-5 text-3xl md:text-4xl">{t.summary_title}</h2>
    <p class="text-justify text-xl">
      {t.summary}
    </p>

    <h2 class="mt-10 text-3xl md:text-4xl">{t.contact_title}</h2>

    <div class="z-10 my-4 text-texto-sft">
      <ul class="flex flex-col text-xl no-underline">
        <li class="my-3">
          <a
            href="https://www.linkedin.com/in/lasfito/"
            target="_blank"
            class="snake flex items-center gap-4"
            rel="noreferrer"
            class="flex w-[500px] items-center"
          >
            <FaLinkedinIn />
            {t.linkedin_text}
          </a>
        </li>
        <li class="my-3">
          <a
            href="https://github.com/lasfito"
            target="_blank"
            class="snake flex items-center gap-4"
            rel="noreferrer"
          >
            <FaGithub />
            {t.github_text}
          </a>
        </li>
        <li class="my-3">
          <a
            href="mailto:hola@lasfi.to"
            class="snake flex items-center gap-4"
            rel="noreferrer"
          >
            <FaEnvelope />
            {t.email_text}
          </a>
        </li>
      </ul>
    </div>
  </section>
</PageHTML>
