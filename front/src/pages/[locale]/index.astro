---
import {HomeHero} from "../../components/HomeHero";
import {HomeAcerca} from "../../components/HomeAcerca";
import {HomeContacto} from "../../components/HomeContacto";
import PageHTML from "../../layouts/PageHTML.astro";
import { AVAILABLE_LANGS } from "../../consts";

const { locale } = Astro.params;


// Validate locale
if (!AVAILABLE_LANGS.includes(locale as any)) {
  return Astro.redirect("/404")
  throw new Error(`Locale ${locale} is not supported. Supported locales are: ${AVAILABLE_LANGS.join(', ')}`);
}
---

<PageHTML
  title="Lasfito"
  description="Tutoriales de desarrollo web sin relleno."
lang={locale}
  type="website"
  date="2021-05-28"
>
  <HomeHero currentLocale={locale as ValidLocale}  client:load />
  <HomeAcerca currentLocale={locale as ValidLocale}  client:load/>
  <HomeContacto currentLocale={locale as ValidLocale} client:load /> 
</PageHTML>
