---
import PageHTML from "../../../layouts/PageHTML.astro";
import {db} from "../../../config/firebaseAdmin"
import { AVAILABLE_LANGS } from "../../../consts";
const { locale } = Astro.params;

// Validate locale
if (!AVAILABLE_LANGS.includes(locale as any)) {
  throw new Error(`Locale ${locale} is not supported. Supported locales are: ${AVAILABLE_LANGS.join(', ')}`);
}

const snapshot = await db.collection('blog').get();
snapshot.forEach((doc) => {
});

---

<PageHTML
  title="Blog de lasfito"
  description="Aquí comparto mis pensamientos :v"
  lang={locale}
  type="website"
  date="2021-05-28"
>
  astroParams: {locale}
</PageHTML>
