---
import PageHTML from "../../layouts/PageHTML.astro";
import {AcercaAutor} from "../../components/AcercaAutor";
import {trans} from "../../i18n/index"
import { AVAILABLE_LANGS } from "../../consts";

const {locale} = Astro.params;

// Validate locale
if (!AVAILABLE_LANGS.includes(locale as any)) {
  return Astro.redirect("/404")
}

const t = trans[locale as ValidLocale].newsletter;
---

<PageHTML
  title={t.title}
  description={t.description}
  lang={locale}
  type="website"
  date="2021-05-28"
>
  <AcercaAutor 
    title="1-2-3" 
    body={t.body} 
  />
</PageHTML>
