{
  "name": "lasfi.to",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:output": "concurrently \"npm run dev:css\" \"astro dev\"",
    "dev:css": "tailwindcss -w -i src/styles/tailwind.css -o public/output.css",
    "start": "astro dev",
    "build": "astro build",
    "build:css": "tailwindcss -m -i src/styles/tailwind.css -o public/output.css",
    "preview": "astro preview",
    "astro": "astro",
    "test": "playwright test",
    "prepare": "husky install && npx astro sync",
    "commit-check": "tsc --noEmit && lint-staged"
  },
  "dependencies": {
    "@astrojs/netlify": "^5.2.1",
    "@astrojs/partytown": "2.1.0",
    "@astrojs/react": "3.5.0",
    "@tailwindcss/typography": "0.5.13",
    "astro": "4.10.1",
    "astro-seo-schema": "4.0.2",
    "firebase-admin": "^13.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.2.1"
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.1.5",
    "@astrojs/tailwind": "5.1.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "concurrently": "^8.2.2",
    "husky": "9.0.11",
    "lint-staged": "15.2.5",
    "postcss-custom-properties": "13.3.10",
    "prettier": "3.3.1",
    "prettier-plugin-tailwindcss": "0.6.2",
    "tailwindcss": "3.4.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write -u"
    ],
    "*.{css,less,scss,sass}": [
      "prettier --write -u"
    ]
  }
}
